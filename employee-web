import React, { useState } from "react";

function App() {
  const [page, setPage] = useState("login");
  const [username, setUsername] = useState("");
  const [password, setPassword] = useState("");
  const [inputData, setInputData] = useState("");
  const [result, setResult] = useState("");
  const [score, setScore] = useState(null);

  // 🔗 LOGIN (Backend decides role)
  const handleLogin = async () => {
    try {
      const res = await fetch("http://localhost:3000/login", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ username, password })
      });

      const data = await res.json();

      if (data.success) {
        setPage(data.role); // 👈 employee or admin from backend
      } else {
        alert("Invalid Credentials");
      }
    } catch {
      alert("Backend not running");
    }
  };

  const runScan = () => {
    const fakeScore = Math.floor(Math.random() * 100);
    setScore(fakeScore);
    setResult(fakeScore > 60 ? "⚠️ High Fraud Risk" : "✅ Safe Content");
  };

  // 🌌 BACKGROUND
  const pageStyle = {
    minHeight: "100vh",
    backgroundImage:
      "linear-gradient(rgba(10,37,64,0.75), rgba(10,37,64,0.85)), url('/barclay.jpg')",
    backgroundSize: "cover",
    backgroundPosition: "center",
    fontFamily: "Segoe UI",
    color: "white"
  };

  // 🔷 NAVBAR
  const navbar = {
    padding: "15px 40px",
    display: "flex",
    justifyContent: "space-between",
    alignItems: "center"
  };

  const logoBox = {
    display: "flex",
    alignItems: "center",
    gap: "10px"
  };

  const logo = {
    width: "40px",
    height: "40px"
  };

  const card = {
    background: "rgba(255,255,255,0.95)",
    borderRadius: "12px",
    padding: "25px",
    boxShadow: "0 4px 20px rgba(0,0,0,0.2)",
    color: "black"
  };

  const button = {
    padding: "10px 18px",
    border: "none",
    borderRadius: "6px",
    background: "#2D9CDB",
    color: "white",
    cursor: "pointer",
    marginTop: "10px"
  };

  const input = {
    width: "100%",
    padding: "10px",
    marginTop: "10px",
    borderRadius: "6px",
    border: "1px solid #ccc"
  };

  const logoURL =
    "https://upload.wikimedia.org/wikipedia/commons/4/41/Barclays_logo.svg";

  // 🔐 LOGIN PAGE
  if (page === "login") {
    return (
      <div style={pageStyle}>
        <div style={navbar}>
          <div style={logoBox}>
            <img src={logoURL} alt="Barclays" style={logo} />
            <h2>Barclays AI Fraud Shield</h2>
          </div>
        </div>

        <div style={{ display: "flex", justifyContent: "center", marginTop: "120px" }}>
          <div style={{ ...card, width: "350px" }}>
            <h2 style={{ color: "#0A2540" }}>Login</h2>

            <input
              placeholder="Employee/Admin ID"
              style={input}
              onChange={(e) => setUsername(e.target.value)}
            />

            <input
              type="password"
              placeholder="Password"
              style={input}
              onChange={(e) => setPassword(e.target.value)}
            />

            <button style={button} onClick={handleLogin}>
              Login
            </button>
          </div>
        </div>
      </div>
    );
  }

  // 👨‍💼 EMPLOYEE DASHBOARD
  if (page === "employee") {
    return (
      <div style={pageStyle}>
        <div style={navbar}>
          <div style={logoBox}>
            <img src={logoURL} alt="Barclays" style={logo} />
            <h3>Fraud Dashboard</h3>
          </div>

          <button style={button} onClick={() => setPage("login")}>
            Logout
          </button>
        </div>

        <div style={{ padding: "40px", display: "flex", gap: "20px" }}>
          <div style={{ flex: 2, ...card }}>
            <h3 style={{ color: "#0A2540" }}>Scan Input</h3>

            <textarea
              style={{ ...input, height: "120px" }}
              placeholder="Paste suspicious email / URL / text..."
              onChange={(e) => setInputData(e.target.value)}
            />

            <button style={button} onClick={runScan}>
              Analyze
            </button>
          </div>

          <div style={{ flex: 1, display: "flex", flexDirection: "column", gap: "20px" }}>
            <div style={card}>
              <h4>Risk Score</h4>
              <h2 style={{ color: score > 60 ? "red" : "#2D9CDB" }}>
                {score !== null ? score + "%" : "--"}
              </h2>
            </div>

            <div style={card}>
              <h4>Result</h4>
              <p>{result || "No analysis yet"}</p>
            </div>
          </div>
        </div>
      </div>
    );
  }

  // 👨‍💻 ADMIN PANEL
  if (page === "admin") {
    return (
      <div style={pageStyle}>
        <div style={navbar}>
          <div style={logoBox}>
            <img src={logoURL} alt="Barclays" style={logo} />
            <h3>Admin Panel</h3>
          </div>

          <button style={button} onClick={() => setPage("login")}>
            Logout
          </button>
        </div>

        <div style={{ padding: "40px" }}>
          <div style={card}>
            <h2 style={{ color: "#0A2540" }}>System Overview</h2>
            <p>✔ AI Active</p>
            <p>✔ Fraud Detection Running</p>
          </div>
        </div>
      </div>
    );
  }

  return null;
}

export default App;
